{% extends 'base.html' %}
{% load static %}

{% block title %}Our Services – Vanguard Labs{% endblock %}

{% block content %}
<section class="py-20 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-center mb-4 fade-in">Our Services</h1>
        <p class="text-center text-white/60 max-w-2xl mx-auto mb-12 fade-in">We deliver excellence across the digital spectrum.</p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for service in services %}
            <div class="glass p-6 rounded-2xl hover:shadow-xl hover:shadow-blue-500/10 transition-all group fade-in">
                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-blue-500/20 to-violet-500/20 flex items-center justify-center mb-4 group-hover:scale-110 transition">
                    <i class="{{ service.icon }} text-3xl text-blue-400"></i>
                </div>
                <h3 class="text-xl font-semibold text-white">{{ service.name }}</h3>
                <p class="text-white/50 text-sm mt-2">{{ service.short_description|default:service.description|truncatechars:120 }}</p>
                <a href="{{ service.get_absolute_url }}" class="inline-block mt-4 text-blue-400 hover:text-blue-300 text-sm font-medium transition">Learn More <i class="fas fa-arrow-right ml-1"></i></a>
            </div>
            {% empty %}
            <p class="text-white/50 col-span-full text-center">No services available.</p>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
