{% extends 'base.html' %}
{% load static %}

{% block title %}Profile – Vanguard Labs{% endblock %}

{% block content %}
<section class="py-20 px-4 md:px-8">
  <div class="max-w-4xl mx-auto">
    <div class="glass p-8 md:p-12 rounded-3xl fade-in">
      <div class="flex flex-col md:flex-row items-center gap-6 md:gap-10">
        <div class="relative">
          {% if user.avatar %}
            <img src="{{ user.avatar.url }}" alt="{{ user.username }}" class="w-32 h-32 rounded-full object-cover border-2 border-white/10" />
          {% else %}
            <div class="w-32 h-32 rounded-full bg-gradient-to-br from-blue-500/30 to-violet-500/30 flex items-center justify-center text-5xl text-white/30 border-2 border-white/10">
              <i class="fas fa-user"></i>
            </div>
          {% endif %}
        </div>
        <div class="flex-1 text-center md:text-left">
          <h1 class="text-3xl font-bold text-white">{{ user.get_full_name|default:user.username }}</h1>
          <p class="text-blue-400">@{{ user.username }}</p>
          <p class="text-white/60">{{ user.email }}</p>
          <div class="flex flex-wrap gap-2 mt-3 justify-center md:justify-start">
            <a href="{% url 'accounts:profile_edit' %}" class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-sm hover:bg-white/10 transition">Edit Profile</a>
            <a href="{% url 'accounts:change_password' %}" class="px-4 py-2 rounded-full bg-white/5 border border-white/10 text-sm hover:bg-white/10 transition">Change Password</a>
          </div>
        </div>
      </div>

      <!-- Details -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-8">
        <div class="glass-light p-4 rounded-xl">
          <p class="text-xs text-white/40 uppercase tracking-wider">Phone</p>
          <p class="text-white">{{ user.phone|default:"Not set" }}</p>
        </div>
        <div class="glass-light p-4 rounded-xl">
          <p class="text-xs text-white/40 uppercase tracking-wider">Company</p>
          <p class="text-white">{{ user.company|default:"Not set" }}</p>
        </div>
        <div class="glass-light p-4 rounded-xl">
          <p class="text-xs text-white/40 uppercase tracking-wider">Job Title</p>
          <p class="text-white">{{ user.job_title|default:"Not set" }}</p>
        </div>
        <div class="glass-light p-4 rounded-xl">
          <p class="text-xs text-white/40 uppercase tracking-wider">Member Since</p>
          <p class="text-white">{{ user.date_joined|date:"F d, Y" }}</p>
        </div>
      </div>
      {% if user.bio %}
        <div class="mt-6 p-4 glass-light rounded-xl">
          <p class="text-xs text-white/40 uppercase tracking-wider">Bio</p>
          <p class="text-white/80">{{ user.bio }}</p>
        </div>
      {% endif %}
      <!-- Social links -->
      <div class="flex gap-3 mt-6 justify-center md:justify-start">
        {% if user.website %}<a href="{{ user.website }}" class="text-white/30 hover:text-white transition"><i class="fas fa-globe"></i></a>{% endif %}
        {% if user.github %}<a href="{{ user.github }}" class="text-white/30 hover:text-white transition"><i class="fab fa-github"></i></a>{% endif %}
        {% if user.linkedin %}<a href="{{ user.linkedin }}" class="text-white/30 hover:text-white transition"><i class="fab fa-linkedin-in"></i></a>{% endif %}
        {% if user.twitter %}<a href="{{ user.twitter }}" class="text-white/30 hover:text-white transition"><i class="fab fa-twitter"></i></a>{% endif %}
      </div>
    </div>
  </div>
</section>
{% endblock %}
